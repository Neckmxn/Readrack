rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'aarag1604@gmail.com';
    }
    
    // Book PDFs and covers — anyone authenticated can read, only admin uploads
    match /books/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
